# name: test/sql/quack_attach_with_manual_secret.test
# description: A user-created TYPE quack secret is honoured by ATTACH and is
# group: [sql]

#              NOT silently replaced by the boilstream auto-vend path.
#
# Background — Phase 4 e2e blocker (bead ingestion-agent-cxum):
#   1. LOAD boilstream
#   2. PRAGMA boilstream_bootstrap_session(...)   ← live conn_state
#   3. CREATE SECRET smk (TYPE quack, TOKEN '<valid-jwt>', SCOPE 'quack:host')
#   4. ATTACH 'quack:host' AS r (TYPE quack)
#
# Pre-fix behaviour: step 4 silently no-op'd. LookupQuackSecret found `smk`
# but, because the secret's name doesn't match the internal `__quack__<path>`
# key in conn_state->secret_expiration, it treated the match as "cache miss"
# and re-vended from /auth/api/quack/credentials, installing a SECOND
# scope-matching secret under name `__quack__quack:host`. DuckDB then saw an
# ambiguous match and ATTACH bound to no catalog.
#
# Fix (this commit): user-supplied secrets (name not starting with
# `__quack__`) short-circuit and are returned as-is — the user's token is
# authoritative.
#
# This test exercises the no-bootstrap variant — same bug surfaces because
# the same LookupQuackSecret short-circuit must be in place.

require boilstream

require httpfs

require quack

statement ok
CREATE SECRET smk (TYPE quack, TOKEN 'user-supplied-token-not-a-jwt', SCOPE 'quack:127.0.0.1:1');

# Sanity: secret is in the catalog under the user's chosen name with the
# scope they specified.
query III
SELECT name, type, scope FROM duckdb_secrets() WHERE name='smk';
----
smk	quack	['quack:127.0.0.1:1']

# ATTACH against a closed loopback port. With the fix in place, the user's
# `smk` secret is used as-is — the boilstream auto-vend path is skipped.
# The Quack handshake then fails on the network (connection refused) and returns
# a connection / transport error. What we MUST NOT see is "(empty)" / no
# error AND no catalog (the silent-no-op symptom of the pre-fix bug).
statement error
ATTACH 'quack:127.0.0.1:1' AS r (TYPE quack);
----
Could not connect to server

# After the failed ATTACH, the catalog `r` must not exist.
query I
SELECT count(*) FROM duckdb_databases() WHERE database_name='r';
----
0

# The user's secret remains untouched after the failed ATTACH — the auto-vend
# path didn't get to overwrite it with an `__quack__<path>` shadow.
query I
SELECT count(*) FROM duckdb_secrets() WHERE name LIKE '__quack__%';
----
0
