# name: test/sql/quack_bridge.test
# description: boilstream Quack auth/authz/bind callbacks
# group: [sql]

require boilstream

# Note: we intentionally DO NOT `require quack` here. The bridge is a pure C++
# shim and must work on its own; Quack only consumes it at runtime via the
# quack_authentication_function / quack_authorization_function GLOBAL settings.

####################
# boilstream_quack_authn — Phase 1 parity with quack_check_token
####################

# Matching tokens => true
query I
SELECT boilstream_quack_authn('s1', 'tok', 'tok');
----
true

# Mismatched tokens => false
query I
SELECT boilstream_quack_authn('s1', 'a', 'b');
----
false

# Different lengths => false (memcmp short-circuit)
query I
SELECT boilstream_quack_authn('s1', 'short', 'longer-token');
----
false

# Empty tokens both sides => false (we conservatively reject empty)
query I
SELECT boilstream_quack_authn('s1', '', '');
----
false

# session_id is currently ignored — null-but-empty sid still works for matched tokens
query I
SELECT boilstream_quack_authn('', 'tok', 'tok');
----
true

####################
# boilstream_quack_authz — read-only first-keyword policy
####################

query I
SELECT boilstream_quack_authz('sid', 'SELECT 1');
----
true

query I
SELECT boilstream_quack_authz('sid', 'PRAGMA version');
----
true

query I
SELECT boilstream_quack_authz('sid', 'EXPLAIN SELECT 1');
----
true

query I
SELECT boilstream_quack_authz('sid', 'DESCRIBE foo');
----
true

query I
SELECT boilstream_quack_authz('sid', 'SHOW TABLES');
----
true

query I
SELECT boilstream_quack_authz('sid', 'WITH cte AS (SELECT 1) SELECT * FROM cte');
----
true

query I
SELECT boilstream_quack_authz('sid', 'CALL quack_stop(''x'')');
----
true

# Leading whitespace + lowercase keyword — must still match
query I
SELECT boilstream_quack_authz('sid', '  select 1');
----
true

query I
SELECT boilstream_quack_authz('sid', E'\t\n  select 1');
----
true

# Phase-2 admit list: DML is allowed (writes route through the central
# ingestion pipeline via the pre-execute rewriter). Catalog allow-list +
# tenant isolation still gate which catalogs the writes can target.
#
# Note: these queries reference unqualified table names (no `cat.schema.t`
# 3-part ref), so the catalog allow-list gate has nothing to reject —
# they pass at the authz layer. The downstream DuckDB execution will
# fail with "table does not exist" for the unbound `sid` (no claims),
# but that's not an authz concern.
query I
SELECT boilstream_quack_authz('sid', 'INSERT INTO t VALUES (1)');
----
true

query I
SELECT boilstream_quack_authz('sid', 'UPDATE t SET x = 1');
----
true

query I
SELECT boilstream_quack_authz('sid', 'DELETE FROM t');
----
true

query I
SELECT boilstream_quack_authz('sid', 'MERGE INTO t USING s ON t.id = s.id WHEN MATCHED THEN UPDATE SET x = s.x');
----
true

# Transaction control is admitted so multi-statement writes work.
query I
SELECT boilstream_quack_authz('sid', 'BEGIN');
----
true

query I
SELECT boilstream_quack_authz('sid', 'COMMIT');
----
true

query I
SELECT boilstream_quack_authz('sid', 'ROLLBACK');
----
true

# DDL is still rejected — DuckLake DDL must go through the catalog-master
# leader RPC (via PGWire), not directly via Quack.
query I
SELECT boilstream_quack_authz('sid', 'CREATE TABLE t(x INT)');
----
false

query I
SELECT boilstream_quack_authz('sid', 'DROP TABLE t');
----
false

query I
SELECT boilstream_quack_authz('sid', 'ALTER TABLE t ADD COLUMN y INT');
----
false

query I
SELECT boilstream_quack_authz('sid', 'TRUNCATE t');
----
false

query I
SELECT boilstream_quack_authz('sid', 'GRANT SELECT ON t TO public');
----
false

query I
SELECT boilstream_quack_authz('sid', 'REVOKE SELECT ON t FROM public');
----
false

# COPY FROM 'file' would bypass our ingestion pipeline, so reject. (We
# don't try to distinguish COPY ... TO 'file' here — Phase-1 keyword
# match is sufficient defense; the path is rare enough that operators
# can route through PGWire.)
query I
SELECT boilstream_quack_authz('sid', 'COPY t FROM ''/tmp/data.csv''');
----
false

# ATTACH is still rejected — operators don't want unbounded local
# attaches over Quack. Quack-spawned Connections come pre-attached
# during ATTACH discovery; the user shouldn't add more.
query I
SELECT boilstream_quack_authz('sid', 'ATTACH ''foo''');
----
false

# Word-boundary check: prefix-equal but not the keyword => reject
query I
SELECT boilstream_quack_authz('sid', 'SELECTOR foo');
----
false

# Empty query => no keyword => reject
query I
SELECT boilstream_quack_authz('sid', '');
----
false

####################
# boilstream_quack_bind_session — stash + count
####################

# Map starts empty (assuming clean process — see comment below)
# Note: this test asserts a delta rather than an absolute count to be robust
# against other tests in the same process having bound sessions earlier.
statement ok
CREATE TEMP TABLE _qb_before AS SELECT boilstream_quack_debug_session_count() AS n;

# Bind two sessions
query I
SELECT boilstream_quack_bind_session('sess-a', 'user-1', 'tenant-1', 'cat1,cat2');
----
true

query I
SELECT boilstream_quack_bind_session('sess-b', 'user-2', 'tenant-2', '');
----
true

# Re-binding the same sid is a no-op count-wise (overwrites in place)
query I
SELECT boilstream_quack_bind_session('sess-a', 'user-1', 'tenant-1', 'cat3');
----
true

# Empty sid is rejected (returns false)
query I
SELECT boilstream_quack_bind_session('', 'u', 't', '');
----
false

# Two new entries since we started
query I
SELECT boilstream_quack_debug_session_count() - (SELECT n FROM _qb_before);
----
2

####################
# Phase-1.5: literal-token fallback when no host-side JWT verifier is
# registered.
#
# The Rust host registers a verifier via `boilstream_quack_set_jwt_verifier()`
# at server startup. This sqllogictest process never calls that setter, so
# the slot stays null and the authn function must take the literal-token
# branch — i.e. exactly the Phase-1 behaviour the assertions at the top
# of this file already cover.
#
# We re-assert the contract here as an explicit fallback section so a
# future change that accidentally drops the fallback path is caught by a
# test whose name and comment make the intent obvious.
####################

# Verifier slot is null → matching tokens still authenticate.
query I
SELECT boilstream_quack_authn('s-fb', 'tok', 'tok');
----
true

# Verifier slot is null → mismatched tokens still fail.
query I
SELECT boilstream_quack_authn('s-fb', 'a', 'b');
----
false

# Verifier slot is null → empty token still rejected.
query I
SELECT boilstream_quack_authn('s-fb', '', '');
----
false

####################
# Phase-2 catalog allow-list enforcement (defense-in-depth on top of the
# multi-tenant fork's ActiveTenantRegistry isolation).
#
# Sessions with a bound `catalogs` list MUST be limited to those catalogs.
# Sessions without a bound entry fall through to keyword-only authz
# (Phase-1 literal-token flow).
####################

# Bind a session that owns just `cat1` and the shared `shared_a` catalog.
statement ok
SELECT boilstream_quack_bind_session('s-allowlist', 'u', 't', 'cat1,shared_a');

# Unqualified queries (no `catalog.schema.table` ref) — allowed by the
# allow-list gate; tenant-isolation handles them downstream.
query I
SELECT boilstream_quack_authz('s-allowlist', 'SELECT 1');
----
true

query I
SELECT boilstream_quack_authz('s-allowlist', 'SELECT * FROM t');
----
true

query I
SELECT boilstream_quack_authz('s-allowlist', 'SELECT * FROM schema.t');
----
true

# 3-part ref naming an allowed catalog — pass.
query I
SELECT boilstream_quack_authz('s-allowlist', 'SELECT * FROM cat1.public.t');
----
true

query I
SELECT boilstream_quack_authz('s-allowlist', 'SELECT * FROM shared_a.public.t');
----
true

# Case-insensitive match: DuckDB folds unquoted idents to lowercase.
query I
SELECT boilstream_quack_authz('s-allowlist', 'SELECT * FROM CAT1.public.t');
----
true

# 3-part ref naming a catalog NOT in the allow-list — REJECT.
query I
SELECT boilstream_quack_authz('s-allowlist', 'SELECT * FROM other_cat.public.t');
----
false

query I
SELECT boilstream_quack_authz('s-allowlist', 'SELECT * FROM evil.public.users');
----
false

# Mixed: one allowed, one not — REJECT (any disallowed ref fails the query).
query I
SELECT boilstream_quack_authz('s-allowlist', 'SELECT * FROM cat1.public.t JOIN other_cat.public.u USING(id)');
----
false

# System catalogs (information_schema / pg_catalog / memory / system / temp)
# are always allowed — discovery queries must keep working.
query I
SELECT boilstream_quack_authz('s-allowlist', 'SELECT * FROM information_schema.tables.x');
----
true

query I
SELECT boilstream_quack_authz('s-allowlist', 'SELECT * FROM pg_catalog.pg_class.x');
----
true

query I
SELECT boilstream_quack_authz('s-allowlist', 'SELECT * FROM memory.main.t');
----
true

# Catalog name inside a string literal — NOT treated as a 3-part ref.
query I
SELECT boilstream_quack_authz('s-allowlist', 'SELECT ''other_cat.public.t'' AS s');
----
true

# Catalog name inside a quoted identifier ("...") — still parsed as a ref
# because DuckDB does resolve those. We reject when the unquoted form is
# not allowed (case-folded for the comparison).
query I
SELECT boilstream_quack_authz('s-allowlist', 'SELECT * FROM "other_cat".public.t');
----
false

# Session with EMPTY allowlist (e.g. fresh user, no catalogs yet) — any
# 3-part ref is rejected. System catalogs still pass.
statement ok
SELECT boilstream_quack_bind_session('s-noclaims', 'u2', 't2', '');

query I
SELECT boilstream_quack_authz('s-noclaims', 'SELECT 1');
----
true

query I
SELECT boilstream_quack_authz('s-noclaims', 'SELECT * FROM any_cat.public.t');
----
false

query I
SELECT boilstream_quack_authz('s-noclaims', 'SELECT * FROM information_schema.tables.x');
----
true

# Sessions with no bound ctx (sid not in SessionMap) fall through to
# keyword-only authz — Phase-1 literal-token flow stays intact.
query I
SELECT boilstream_quack_authz('s-nonexistent', 'SELECT * FROM whatever.public.t');
----
true

####################
# Phase-2: DML interacts with catalog allow-list the same way SELECT does.
# INSERT into an allowed catalog → pass. INSERT into a disallowed catalog
# → REJECT (defense-in-depth).
####################

# INSERT into the allowed `cat1` catalog passes both keyword + allow-list.
query I
SELECT boilstream_quack_authz('s-allowlist', 'INSERT INTO cat1.public.t VALUES (1)');
----
true

# UPDATE / DELETE / MERGE against allowed catalog all pass.
query I
SELECT boilstream_quack_authz('s-allowlist', 'UPDATE cat1.public.t SET x = 1 WHERE id = 1');
----
true

query I
SELECT boilstream_quack_authz('s-allowlist', 'DELETE FROM cat1.public.t WHERE id = 1');
----
true

# INSERT against a disallowed catalog is rejected by the allow-list gate.
query I
SELECT boilstream_quack_authz('s-allowlist', 'INSERT INTO other_cat.public.t VALUES (1)');
----
false

query I
SELECT boilstream_quack_authz('s-allowlist', 'DELETE FROM other_cat.public.t WHERE id = 1');
----
false

# An UPDATE that joins allowed and disallowed catalogs → reject (any
# disallowed ref fails).
query I
SELECT boilstream_quack_authz('s-allowlist', 'UPDATE cat1.public.t SET x = (SELECT v FROM other_cat.public.s WHERE id = 1)');
----
false

####################
# Session-init hook handler — exercises boilstream_quack_session_init
# directly via the test-only debug shim. The shim drives the SAME
# handler that the patched Quack server calls from CreateNewConnection,
# but using THIS connection's ClientContext so we can read back the
# stamped tenant_id via current_setting() in the same session.
####################

# Unbound sid → handler is a no-op → no tenant_id stamped.
query T
SELECT boilstream_quack_debug_invoke_session_init('never-bound-sid');
----
(empty)

# Null sid → handler early-returns → still no stamping. The shim returns
# whatever's currently in the boilstream.tenant_id setting (empty here).
query T
SELECT boilstream_quack_debug_invoke_session_init(NULL);
----
NULL

# Bind a session with EMPTY tenant_id → handler reaches the
# `tid.empty()` early-return → no stamping.
statement ok
SELECT boilstream_quack_bind_session('sess-empty-tid', 'u', '', '');

query T
SELECT boilstream_quack_debug_invoke_session_init('sess-empty-tid');
----
(empty)

# Bind a session with a real tenant_id and drive the handler. Note:
# the fork's `duckdb_set_tenant_id_on_context` requires a fresh
# ClientContext — the tenant context locks on the first BeginQueryInternal,
# after which SetTenantId returns false. In production Quack calls the
# hook from CreateNewConnection, BEFORE any user query — that path is
# unreachable from sqllogictest because every test query has already
# locked the context running it.
#
# So the SQL test can only assert that:
#   1. binding the session succeeded (count went up earlier),
#   2. invoking the handler on a locked context doesn't crash,
#   3. the safety guard (`tenant.locked` return-false) holds.
# End-to-end "stamping actually fires" coverage lives in the C++ unit
# test (tests/cpp/test_quack_bridge.cpp), which constructs a fresh
# Connection in-process and drives the handler before any query runs.
statement ok
SELECT boilstream_quack_bind_session('sess-stamp-tid', 'u', 'tenant-stamp-7', 'cat1');

statement ok
SELECT boilstream_quack_debug_invoke_session_init('sess-stamp-tid');
