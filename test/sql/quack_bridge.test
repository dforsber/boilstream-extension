# name: test/sql/quack_bridge.test
# description: Boilstream Quack bridge fails closed without its Rust host
# group: [sql]

require boilstream

# A standalone community-extension process has no host JWT verifier. Literal
# token comparison was intentionally removed: a missing verifier cannot create
# an authority-free session.
query I
SELECT boilstream_quack_authn('s1', 'tok', 'tok');
----
false

query I
SELECT boilstream_quack_authn('s1', '', '');
----
false

# Authorization is session-bound. Without a successfully verified session the
# scalar rejects every SQL shape; typed planning/authorization is exercised by
# the C++/Rust integration tests.
query I
SELECT boilstream_quack_authz('s1', 'SELECT 1');
----
false

query I
SELECT boilstream_quack_authz('s1', 'INSERT INTO t VALUES (1)');
----
false

query I
SELECT boilstream_quack_debug_session_count();
----
0
