# name: test/sql/quack_secret_autovend.test
# description: TYPE quack secret is auto-vended from boilstream server on lookup (Phase 2.2)
# group: [sql]

require boilstream

require quack

# The `quack` SecretType is registered upstream by the `quack` extension itself
# (RegisterQuackSecretType in quack_extension.cpp) — boilstream deliberately does
# NOT re-register it (would throw "Attempted to register an already registered
# secret type"). What boilstream owns is the *auto-vend* path in
# RestApiSecretStorage::LookupQuackSecret: when DuckDB looks up a quack secret
# and the local catalog has no fresh match, the extension calls
# GET /auth/api/quack/credentials on the boilstream server and materialises a
# KeyValueSecret with token + endpoint.
#
# The full e2e (real ATTACH 'quack:host' → live JWT mint → query) needs a
# running boilstream server and is added by Phase 4. This test stays in the
# unit lane: it confirms the type is visible and the boilstream extension
# loaded cleanly alongside it.
query I
SELECT count(*) FROM duckdb_secret_types() WHERE type = 'quack';
----
1

# Provider "config" and extension "quack" are part of the upstream registration
# contract — asserting them ensures we haven't accidentally shadowed it from
# boilstream (which would crash extension load on duplicate registration).
query II
SELECT default_provider, extension FROM duckdb_secret_types() WHERE type = 'quack';
----
config	quack
