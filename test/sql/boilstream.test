# name: test/sql/boilstream.test
# description: test boilstream extension
# group: [sql]

# Before we load the extension, this will fail
statement error
PRAGMA boilstream_bootstrap_session('https://localhost:443/secrets:ffe14a7a000000010000000168e4f9a5bcca736c3adaaf0f63e735f881adc397db6da85f1b9e231f70bbf6f71db4ef9fad837bc8');
