# name: test/sql/client_boundary.test
# description: Public client API exists without hosted-server callbacks
# group: [sql]

require boilstream

query I
SELECT count(*) FROM duckdb_functions() WHERE function_name IN ('boilstream_quack_authn', 'boilstream_quack_authz', 'boilstream_quack_debug_session_count');
----
0

query I
SELECT count(DISTINCT function_name) FROM duckdb_functions() WHERE function_name IN ('boilstream_login', 'boilstream_register_user', 'boilstream_verify_mfa', 'boilstream_bootstrap_session', 'boilstream_resume_session', 'boilstream_secrets', 'boilstream_ducklakes');
----
7

statement error
SELECT boilstream_quack_authn('s1', 'token', 'token');
----
does not exist

statement error
SELECT boilstream_quack_authz('s1', 'SELECT 1');
----
does not exist

statement error
SELECT boilstream_quack_debug_session_count();
----
does not exist

# Server routing settings are not part of the public client contract.
query I
SELECT count(*) FROM duckdb_settings() WHERE name = 'boilstream.tenant_id';
----
0

statement error
SET "boilstream.tenant_id" = '42';
----
unrecognized configuration parameter

# A fresh connection has no credential to resume; this must not contact a server.
statement error
PRAGMA boilstream_resume_session;
----
authenticated connection
